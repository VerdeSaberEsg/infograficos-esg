generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id         String       @id @db.VarChar(14)
  createdAt  DateTime     @default(now())
  campos     CampoValor[]
  coletas    Coleta[]
}

model CampoValor {
  id           String   @id @default(cuid())
  cnpj         String   @db.VarChar(14)
  codigo       String
  valor        Json?
  indisponivel Boolean @default(false)
  motivo       String?
  fonte        String?
  fonteUrl     String?
  coletadoEm   DateTime @default(now())
  empresa      Empresa  @relation(fields: [cnpj], references: [id])

  @@index([cnpj, codigo])
}

model Coleta {
  id          String   @id @default(cuid())
  cnpj        String   @db.VarChar(14)
  codigo      String
  executadoEm DateTime @default(now())
  resultado   Json
  empresa     Empresa  @relation(fields: [cnpj], references: [id])

  @@index([cnpj, codigo])
}
